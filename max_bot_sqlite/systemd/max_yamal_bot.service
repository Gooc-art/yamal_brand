[Unit]
Description=YAMAL MAX bot (SQLite catalog)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/sergey/yamal_brand/max_bot_sqlite
EnvironmentFile=/home/sergey/yamal_brand/max_bot_sqlite/.env
ExecStart=/home/sergey/yamal_brand/.runtime/node/bin/node /home/sergey/yamal_brand/max_bot_sqlite/src/bot.js
Restart=always
RestartSec=3
User=sergey

[Install]
WantedBy=multi-user.target
