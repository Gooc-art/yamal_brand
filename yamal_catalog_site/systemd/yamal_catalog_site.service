[Unit]
Description=YAMAL Catalog Website
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/sergey/yamal_brand/yamal_catalog_site
Environment=SITE_HOST=0.0.0.0
Environment=SITE_PORT=3200
Environment=SITE_CATALOG_DB_PATH=/home/sergey/yamal_brand/max_catalog.db
Environment=SITE_RUNTIME_DB_PATH=/home/sergey/yamal_brand/max_bot_runtime.db
Environment=SITE_CATALOG_ROOT_PATH=/home/sergey/yamal_brand/input/Макеты1
ExecStart=/home/sergey/yamal_brand/.runtime/node/bin/node /home/sergey/yamal_brand/yamal_catalog_site/src/server.js
Restart=always
RestartSec=5
User=sergey

[Install]
WantedBy=multi-user.target
